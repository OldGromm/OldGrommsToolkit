	<DropdownButton name="GRTKMountsDropdownShortTemplate" mixin="WowStyle1DropdownMixin" virtual="true">
		<Size x="150" y="30"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="common-dropdown-textholder" useAtlasSize="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-8" y="7"/>
						<Anchor point="BOTTOMRIGHT" x="8" y="-9"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Arrow" atlas="common-dropdown-a-button" useAtlasSize="true">
					<Anchors>
						<Anchor point="RIGHT" relativePoint="RIGHT" x="1" y="-3"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Text" inherits="GRTKMountsFontRegular" wordwrap="false" justifyH="LEFT">
					<Size x="0" y="10"/>
					<Anchors>
						<Anchor point="TOPRIGHT" relativeKey="$parent.Arrow" relativePoint="LEFT"/>
						<Anchor point="TOPLEFT" x="8" y="-8"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
		</Scripts>
	</DropdownButton>

	<Font name="GRTKMountsFontNormal" inherits="GRTKMountsFontSize12" virtual="true">
		<Color r="0.964" g="0.916" b="0.596"/>
	</Font>

	<Font name="GRTKMountsFontHighlight" inherits="GRTKMountsFontNormal" virtual="true">
		<Color r="0.92" g="0.812" b="0.18"/>
	</Font>

	<Font name="GRTKMountsFontDisable" inherits="GRTKMountsFontNormal" virtual="true">
		<Color r="0.596" g="0.592" b="0.504"/>
	</Font>
	
	<Button name="GRTKMountsButtonTemplate" mixin="UIButtonFitToTextBehaviorMixin" virtual="true">
		<KeyValues>
			<KeyValue key="fitTextCanWidthDecrease" value="true" type="boolean"/>
			<KeyValue key="fitTextWidthPadding" value="40" type="number"/>
		</KeyValues>
		<Size x="40" y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Left" file="Interface\Buttons\UI-Panel-Button-Up">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0" right="0.09375" top="0" bottom="0.6875"/>
				</Texture>
				<Texture parentKey="Right" file="Interface\Buttons\UI-Panel-Button-Up">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0.53125" right="0.625" top="0" bottom="0.6875"/>
				</Texture>
				<Texture parentKey="Middle" file="Interface\Buttons\UI-Panel-Button-Up">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0.09375" right="0.53125" top="0" bottom="0.6875"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad function="UIPanelButton_OnLoad"/>
			<OnMouseDown function="UIPanelButton_OnMouseDown"/>
			<OnMouseUp function="UIPanelButton_OnMouseUp"/>
			<OnShow function="UIPanelButton_OnShow"/>
			<OnDisable function="UIPanelButton_OnDisable"/>
			<OnEnable function="UIPanelButton_OnEnable"/>
		</Scripts>
		<ButtonText name="$parentText" parentKey="Text"/>
		<NormalFont style="GRTKMountsFontNormal"/>
		<HighlightFont style="GRTKMountsFontHighlight"/>
		<DisabledFont style="GRTKMountsFontDisable"/>
		<HighlightTexture inherits="UIPanelButtonHighlightTexture"/>
	</Button>

